{
  "name": "joystick-gui",
  "version": "2.0.0",
  "private": true,
  "description": "Joystick: a GUI benchmarking tool built on the Yardstick benchmark",
  "homepage": "https://github.com/atlarge-research/yardstick",
  "author": {
    "name": "Marwan Amrhar",
    "email": "marwan1amrhar@gmail.com"
  },
  "main": "electron/main.js",
  "scripts": {
    "install:all": "npm install && cd client && npm install",
    "build": "cd client && npx vite build",
    "start": "npm run build && electron .",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "dist:linux": "npm run build && electron-builder --linux",
    "dist:win": "npm run build && electron-builder --win",
    "dist:linux-win": "npm run build && electron-builder --linux --win"
  },
  "dependencies": {
    "@aws-sdk/client-ec2": "^3.1045.0",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "socket.io": "^4.7.4",
    "ssh2": "^1.15.0",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "electron": "^41.1.0",
    "electron-builder": "^26.8.1"
  },
  "build": {
    "appId": "com.joystick.gui",
    "productName": "Joystick",
    "npmRebuild": false,
    "files": [
      "electron/**/*",
      "server/**/*",
      "client/dist/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../yardstick_benchmark/games/minecraft",
        "to": "yardstick_benchmark/games/minecraft",
        "filter": [
          "**/*.yml",
          "**/*.j2",
          "**/*.js",
          "!**/__pycache__/**",
          "!**/node_modules/**"
        ]
      }
    ],
    "directories": {
      "output": "release"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "maintainer": "marwan amrhar <marwan1amrhar@gmail.com>",
      "category": "Development"
    },
    "mac": {
      "target": "dmg"
    },
    "win": {
      "target": "nsis"
    }
  }
}
